# NewVision System Configuration
# Copy this file to .env and adjust variables as needed

# Host and Network Ports
NEWVISION_HOST=0.0.0.0
NEWVISION_HTTP_PORT=8000
NEWVISION_UDP_PORT=5005

# Ingestion & Streaming
NEWVISION_BUFFER_SIZE=1000
NEWVISION_PUSH_HZ=20.0
NEWVISION_STALE_SEC=3.0

# Wi-Fi SoftAP Configuration
NEWVISION_AP_SSID=CSI_TEST
NEWVISION_AP_PASSWORD=csi_sensing_pass
NEWVISION_AP_CHANNEL=6
NEWVISION_AP_GATEWAY_IP=192.168.4.1

# Node IP Assignments (Subnet 192.168.4.0/24)
NEWVISION_LAPTOP_IP=192.168.4.2
NEWVISION_RADAR_NODE_IP=192.168.4.10
NEWVISION_MAG_NODE_IP=192.168.4.20
